generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  age       Int?
  height    Float?
  weight    Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}